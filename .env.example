# ============================================================
# API Gateway CAMEIA — Variables de entorno
# Copia este archivo como .env y rellena los valores reales.
# NUNCA commitees el archivo .env.
# ============================================================

# ── Identidad del servicio ──────────────────────────────────
SPRING_APPLICATION_NAME=cameia-gateway
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# ── Firebase Admin SDK (OBLIGATORIO) ───────────────────────
# ID del proyecto en Firebase Console (sin comillas)
FIREBASE_PROJECT_ID=

# Ruta absoluta al JSON de la service account de Firebase.
# Descárgalo desde Firebase Console → Configuración → Cuentas de servicio.
GOOGLE_APPLICATION_CREDENTIALS=

# Ruta absoluta al mismo JSON, usada por docker-compose para montarlo como volumen.
# Ejemplo (Mac/Linux): FIREBASE_KEY_PATH=/home/usuario/secretos/cameia-firebase.json
# Ejemplo (Windows):   FIREBASE_KEY_PATH=C:/Users/usuario/secretos/cameia-firebase.json
# NUNCA pongas aquí la ruta dentro de tu repositorio.
FIREBASE_KEY_PATH=

# ── URLs de microservicios downstream (OBLIGATORIO) ─────────
# Con Docker + red cameia-net: CAMEIA_PERFIL_URL ya está fijada en docker-compose.yml
# (http://cameia-perfil-app:8082). Las siguientes son para arranque sin Docker o futuros servicios.
CAMEIA_CUENTAS_URL=http://localhost:8081
CAMEIA_ENTREVISTA_URL=http://localhost:8083
# CAMEIA_PERFIL_URL no va aquí: el compose usa el nombre de contenedor, no localhost.

# ── URLs de microservicios futuros (opcional ahora) ─────────
# Descomenta cuando el servicio exista.
# CAMEIA_VOZ_URL=http://localhost:8084
# CAMEIA_AUDITORIA_URL=http://localhost:8085

# ── CORS ────────────────────────────────────────────────────
# Origen de cameia-web en desarrollo local (Vite default).
# En producción: URL pública de cameia-web.
GATEWAY_CORS_ALLOWED_ORIGIN=http://localhost:5173

# ── Timeouts ─────────────────────────────────────────────────
# Tiempo máximo de respuesta del downstream en milisegundos.
GATEWAY_TIMEOUT_MS=30000

# ── Logging y Actuator ───────────────────────────────────────
LOG_LEVEL=INFO
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info
